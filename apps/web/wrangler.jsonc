{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xuanxue-web",
  // 自定义入口：先校验环境变量，再交给 TanStack Start（src/server.ts）
  "main": "./src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      // 牌图直通；同目录下的工具 HTML 仍须经过站点守卫。
      "!/tarot/*.webp",
      "!/tarot/SOURCES.md",
      "!/fonts/*",
      "!/images/*",
      // 站点图标在 /images/favicon-<site>.*；/favicon.ico 经 Worker 按 Host 重定向到本站图标
      "!/og/*",
      "!/src/*",
      "!/@*",
      "!/node_modules/*"
    ]
  },

  // FILES 专用私有桶；顶层由 Miniflare 模拟，预签名配置必须与绑定一致。
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "xuanxue-files" }],
  // 本地开发时 localConnectionString 指向主 checkout 的 xuanxue_dev；
  // Orca worktree 中由 vite.config.ts 从 .env.worktree 读取
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE(_CACHED) 覆盖。
  // 顶层 id 为占位值，只用于本地开发；staging 见 env.staging（阶段一，docs/07 §0）。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://app:app@localhost:5433/xuanxue_dev"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://app:app@localhost:5433/xuanxue_dev"
    }
  ],
  // Workflow 定义在 apps/jobs，这里按 script_name 绑定（docs/02-project-structure.md §2）

  // web 为 producer，apps/jobs 为 consumer
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "xuanxue-email" },
      { "binding": "EVENTS_QUEUE", "queue": "xuanxue-events" }
    ]
  },
  // Better Auth 会话的 secondaryStorage（packages/auth/src/session.ts）；本地由 Miniflare 模拟，id 为占位值
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  // 认证入口按 IP + 邮箱限流（packages/auth/src/protection.ts）：每个 key 每 60 秒 10 次；
  // AI 接口按空间 + 用户限流（features/ai/chat.ts）：每个 key 每 60 秒 20 次，只用于防刷；本地由 Miniflare 模拟
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],
  // 本地开发的站点地址；`vite dev` 时由 vite.config.ts 按 .env.worktree 的端口覆盖。
  // TURNSTILE_SITE_KEY 为 Cloudflare 官方测试 site key（始终通过），与 .dev.vars 中的测试 secret 配对
  "vars": {
    "SENTRY_ENVIRONMENT": "development",
    "PAYMENT_MODE": "test",
    "APP_URL": "http://localhost:3000",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "R2_FILES_BUCKET": "xuanxue-files"
  },
  // hyperdrive / workflows / queues / kv_namespaces / ratelimits / vars 不会从顶层继承，每个环境都要重新声明。
  // staging 认证使用独立 KV、限流命名空间和官方 Turnstile 测试 key。
  // staging Google 使用占位凭据满足启动校验；正式域名就绪后再配置真实 OAuth 应用。
  // 构建时用 CLOUDFLARE_ENV=staging 选择该环境（见 package.json 的 deploy:staging）。
  "env": {
    "staging": {
      "name": "xuanxue-web-staging",

      "r2_buckets": [{ "binding": "FILES", "bucket_name": "xuanxue-files-staging" }],
      "vars": {
        "SENTRY_ENVIRONMENT": "staging",
        "PAYMENT_MODE": "test",
        "APP_URL": "https://xuanxue-web-staging.saas-jobs.workers.dev",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "AI_GATEWAY_ACCOUNT_ID": "",
        "AI_GATEWAY_ID": "",
        // Gateway 整段缓冲 DeepSeek SSE（#152）；有 DEEPSEEK_API_KEY secret 时直连，缺失时仍走 Gateway。
        "AI_TEXT_EGRESS": "direct",
        "R2_ACCOUNT_ID": "",
        "R2_FILES_BUCKET": "xuanxue-files-staging"
      },
      "kv_namespaces": [{ "binding": "CACHE", "id": "99fee60cbaca4d71ab280da1056b291e" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "21002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_AI", "namespace_id": "21004", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_API", "namespace_id": "21006", "simple": { "limit": 60, "period": 60 } }
      ],
      "hyperdrive": [
        // Neon xuanxue_staging，app 非 pooled TLS 直连；分别关闭缓存与缓存 60 秒（docs/07 §2）
        { "binding": "HYPERDRIVE", "id": "997c773bdb46458bab6af316630aad8c" },
        { "binding": "HYPERDRIVE_CACHED", "id": "99d5848802b54b24925d8d5f1dfd5ad3" }
      ],

      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "xuanxue-email-staging" },
          { "binding": "EVENTS_QUEUE", "queue": "xuanxue-events-staging" }
        ]
      }
    },
    // launch-v1-production 2.1：本项目独立资源，见 docs/runbooks/production-xuanxue.md。
    // 不设 PAYMENT_MODE（Q9 前支付关闭）与 AI_FAULT_INJECTION（生产禁止）。
    "production": {
      "name": "xuanxue-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "ganjiday.com", "custom_domain": true },
        { "pattern": "arcanumber.com", "custom_domain": true }
      ],

      "r2_buckets": [{ "binding": "FILES", "bucket_name": "xuanxue-files-production" }],
      "vars": {
        "SENTRY_ENVIRONMENT": "production",
        "APP_URL": "https://arcanumber.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFdAs5UkBviOud_w",
        "AI_TEXT_EGRESS": "direct",
        "R2_ACCOUNT_ID": "",
        "R2_FILES_BUCKET": "xuanxue-files-production"
      },
      "kv_namespaces": [{ "binding": "CACHE", "id": "b78752af8dc14c749396378288c3e52f" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "22002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_AI", "namespace_id": "22004", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_API", "namespace_id": "22006", "simple": { "limit": 60, "period": 60 } }
      ],
      "hyperdrive": [
        // Neon xuanxue_production，app 非 pooled TLS 直连；分别关闭缓存与缓存 60 秒
        { "binding": "HYPERDRIVE", "id": "be92ef3d14a94d27bd87ed3a459d32ce" },
        { "binding": "HYPERDRIVE_CACHED", "id": "91c3e6d0fd5d44ba8f5c0864bb9450d9" }
      ],

      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "xuanxue-email-production" },
          { "binding": "EVENTS_QUEUE", "queue": "xuanxue-events-production" }
        ]
      }
    }
  }
}
