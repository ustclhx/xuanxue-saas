{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // vite/client：构建期分享图经 layout.tsx → sample.ts 引入分享卡片注册表（读取 import.meta.env / hot）
    "types": ["node", "vite/client"],
    // 构建期分享图（scripts/og-images.ts）复用 src 中的 JSX 版式
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.smoke.config.ts",
    "playwright.disconnect.config.ts",
    "playwright.stripe.config.ts",
    "scripts",
    "test/global-setup.ts",
    "e2e",
    "e2e-live"
  ],
  "exclude": [
    "e2e/staging-acceptance/local-media.ts",
    "e2e/staging-acceptance/fault-local-media.ts"
  ]
}
