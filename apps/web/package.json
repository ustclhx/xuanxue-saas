    "@fontsource/noto-sans-tc": "^5.3.1",
    "@sentry/cloudflare": "^11.6.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@xuanxue/ai": "workspace:*",
    "@xuanxue/auth": "workspace:*",
    "@xuanxue/bazi": "workspace:*",
    "@xuanxue/billing": "workspace:*",
    "@xuanxue/config": "workspace:*",
    "@xuanxue/credits": "workspace:*",
    "@xuanxue/db": "workspace:*",
    "@xuanxue/email": "workspace:*",
    "@xuanxue/entitlements": "workspace:*",
    "@xuanxue/numerology": "workspace:*",
    "@xuanxue/platform": "workspace:*",
    "@xuanxue/shared": "workspace:*",
    "@xuanxue/storage": "workspace:*",
    "@xuanxue/tarot": "workspace:*",
    "@xuanxue/ui": "workspace:*",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/vite": "^0.3.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "beasties": "^0.5.5",
    "cf-workers-og": "3.0.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
