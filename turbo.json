{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["APP_URL", "EAST_URL", "WEST_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["EVIDENCE_DIR"],
      "dependsOn": ["^typecheck", "^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
